# Generate deploy/.env with: ./scripts/deploy.sh init
# Only API domain, without scheme/path. DNS A must point at the server.
PILOTFLOW_DOMAIN=api.example.com
# Exact frontend origin, without trailing slash; no wildcard.
PILOTFLOW_FRONTEND_ORIGIN=https://app.example.com
# Actual existing HTTPS OIDC issuer and access-token audience (not a made-up URL).
PILOTFLOW_JWT_AUTHORITY=https://auth.example.com/realms/pilot-flow
PILOTFLOW_JWT_AUDIENCE=pilot-flow-api
# init generates independent random passwords. Do not change on an existing database.
PILOTFLOW_DB_PASSWORD=
PILOTFLOW_APP_DB_PASSWORD=
# Use a unique version for each deployment to keep previous images for rollback.
PILOTFLOW_RELEASE=initial
